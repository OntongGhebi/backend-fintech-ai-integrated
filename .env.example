
# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Jakarta
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Neon
# Use your actual connection string. Production should use secure credentials
# and the connection settings recommended by your database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# JWT — replace both values with independent random secrets
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-for-local-development
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis
# Leave REDIS_URL empty to use the host/port/password settings below.
# If REDIS_URL is provided, it takes precedence over those settings.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-local-redis-password
REDIS_DB=0
BULLMQ_PREFIX=fintech-ai

# Email — required for email delivery
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=Fintech AI <onboarding@example.com>

# Midtrans — use Sandbox credentials for development
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-replace-with-sandbox-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-replace-with-sandbox-key

# Telegram — configure when enabling Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# AI — disabled by default
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
