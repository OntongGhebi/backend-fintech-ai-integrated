# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Timezone
APP_TIMEZONE=Asia/Jakarta

# Database
DATABASE_URL=

# Frontend
FRONTEND_URL=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Resend Email
RESEND_API_KEY=
EMAIL_FROM=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis-password

# BullMQ
BULLMQ_PREFIX=fintech-ai

# Telegram 
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# AI
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000